{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"weather-app": {
			"projectType": "application",
			"schematics": {},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:application",
					"options": {
						"outputPath": "dist/weather-app",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "tsconfig.app.json",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": [
							"src/styles.css"
						],
						"scripts": []
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular-devkit/build-angular:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "weather-app:build:production"
						},
						"development": {
							"buildTarget": "weather-app:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				}
			}
		},
		"weather-data": {
			"projectType": "library",
			"root": "projects/weather-data",
			"sourceRoot": "projects/weather-data/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:ng-packagr",
					"options": {
						"project": "projects/weather-data/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/weather-data/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/weather-data/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				}
			}
		},
		"weather-state": {
			"projectType": "library",
			"root": "projects/weather-state",
			"sourceRoot": "projects/weather-state/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:ng-packagr",
					"options": {
						"project": "projects/weather-state/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/weather-state/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/weather-state/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				}
			}
		},
		"weather-ui": {
			"projectType": "library",
			"root": "projects/weather-ui",
			"sourceRoot": "projects/weather-ui/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:ng-packagr",
					"options": {
						"project": "projects/weather-ui/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/weather-ui/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/weather-ui/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				}
			}
		},
		"weather-elements": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/weather-elements",
      "sourceRoot": "projects/weather-elements/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/weather-elements",
            "index": "projects/weather-elements/src/index.html",
            "browser": "projects/weather-elements/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/weather-elements/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/weather-elements/public"
              }
            ],
            "styles": [
              "projects/weather-elements/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "weather-elements:build:production"
            },
            "development": {
              "buildTarget": "weather-elements:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        }
      }
    }
	}
}